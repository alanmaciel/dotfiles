# Ghostty
# https://ghostty.org/docs/config

# ── aspecto ───────────────────────────────────────────────────────────
# Misma fuente y tamaño que tienes en iTerm2.
font-family = Menlo
font-size = 14
theme = TokyoNight Night

window-padding-x = 8
window-padding-y = 6
window-save-state = always
mouse-hide-while-typing = true
macos-titlebar-style = tabs

# ── atajos ────────────────────────────────────────────────────────────
# Terminal desplegable desde cualquier app (requiere permiso de Accesibilidad).
keybind = global:cmd+shift+space=toggle_quick_terminal
# shift+enter = salto de línea sin enviar (Claude Code, también dentro de herdr).
keybind = shift+enter=text:\x1b\r
