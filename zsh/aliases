# ~/.aliases — alias personales. Lo carga ~/.zshrc al final.

# ── Básicos (heredados de thoughtbot/dotfiles) ────────────────────────────
alias ln='ln -v'
alias mkdir='mkdir -p'
alias path='echo $PATH | tr -s ":" "\n"'   # PATH, una ruta por línea
alias b='bundle'

# ── Navegación ────────────────────────────────────────────────────────────
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias -- -='cd -'
alias pu='pushd'
alias po='popd'

alias d='cd ~/Dropbox'
alias p='cd ~/Projects'

# ── Listados ──────────────────────────────────────────────────────────────
alias l='ls -lA1'
alias la='ls -lA'
alias ll='ls -l'
alias lsa='ls -lah'
alias sl='ls'             # por los dedos rápidos

# ── Archivos y sistema ────────────────────────────────────────────────────
alias o='open'
alias oo='open .'
alias afind='ack -il'     # antes llamaba a ack-grep, que no existe en macOS
alias h='history'
alias notify='afplay /System/Library/Sounds/Submarine.aiff -v 10'

# Mostrar/ocultar archivos ocultos en Finder
alias showFiles='defaults write com.apple.finder AppleShowAllFiles YES; killall Finder /System/Library/CoreServices/Finder.app'
alias hideFiles='defaults write com.apple.finder AppleShowAllFiles NO; killall Finder /System/Library/CoreServices/Finder.app'

# ── Editores ──────────────────────────────────────────────────────────────
alias e='open -a emacs'   # Emacs GUI (Doom)
alias todo='$EDITOR ~/.todo'

# ── Git ───────────────────────────────────────────────────────────────────
# Nota: `g` NO se define aquí. La función g de ~/.zshrc da algo mejor:
# sin argumentos hace `git status`, con argumentos actúa como `git`.
alias gs='git status'
alias gst='git status -sb'
alias gd='git diff'
alias gc='git commit'
alias gca='git commit -a'
alias gcm='git commit -a -m'
alias gco='git checkout'
alias gb='git branch'
alias ga='git add .'
alias gl='git pull'
alias gp='git push'
alias gr='git remote -v'
alias glg='git log --pretty=format:"%C(auto)%h - %an, %ar %n  %s %n"'
alias glo="git log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
alias gg='git log --oneline --abbrev-commit --all --graph --decorate --color'
alias gwc='git whatchanged -p --abbrev-commit --pretty=medium'
alias grm="git status | grep deleted | awk '{print \$3}' | xargs git rm"
alias changelog='git log `git log -1 --format=%H -- CHANGELOG*`..; cat CHANGELOG*'

# ── Ruby / Rails ──────────────────────────────────────────────────────────
alias be='bundle exec'
alias rs='rails s'
alias rc='rails c'

# ── Terminal remota ───────────────────────────────────────────────────────
# Fuerza un TERM que el host remoto sí conozca: Ghostty anuncia xterm-ghostty
# y casi ningún servidor trae ese terminfo.
alias ssh='TERM=xterm-256color ssh'

# ── Super usuario ─────────────────────────────────────────────────────────
alias _='sudo'
alias please='sudo'
